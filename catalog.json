  "artistBios": {
    "mc_geich": "МС ГЕИЧ — главный архитектор тёмного звучания Dark Music. Записывает свои куплеты в закрытой серверной студии, совмещая глубокий аналоговый саб-бас и бескомпромиссный речитатив.",
    "mc_makaka": "МС МАКАКА — самая взрывная энергия объединения Dark Music. Его стиль сочетает первобытный ритм бетонных джунглей, перегруженные 808-е бочки и мгновенно запоминающиеся хуки.",
    "mc_ezdit": "МС ЕЗДИТЬ — голос ночных магистралей и красной зоны тахометра. Его треки созданы для пустых трасс, неоновых тоннелей и мощных аудиосистем.",
    "mc_oparysh": "МС ОПАРЫШ — самый мрачный и бескомпромиссный представитель андеграунд-сцены Dark Music. Индустриальные текстуры, тяжёлый шаг ритм-секции и гипнотическая атмосфера подземелья."
  },
  "artistRoles": {
    "mc_geich": "Основатель лейбла • Dark Synth / Кибер-Рэп",
    "mc_makaka": "Король дикого 808 баса • Jungle Trap",
    "mc_ezdit": "Ночной дрифт • Phonk / High-Speed Bass",
    "mc_oparysh": "Андеграунд бункер • Raw Industrial / Dark Bass"
  },
  "artistFacts": {
    "mc_geich": [
      "Первые биты МС ГЕИЧ собирал на кастомном синтезаторе в ночную смену.",
      "Никогда не использует стандартные пресеты сведения — каждый трек проходит через ламповый перегруз.",
      "Все релизы артиста выходят без предварительных анонсов ровно в полночь."
    ],
    "mc_makaka": [
      "Записывает вокал с одного дубля, чтобы сохранить максимальную живую подачу.",
      "Его басовые партии проверяются на сабвуферах мощностью 3 киловатта.",
      "Один из куплетов был записан прямо во время ночного шторма."
    ],
    "mc_ezdit": [
      "В треках МС ЕЗДИТЬ используются реальные звуки выхлопа и переключения передач на 7500 об/мин.",
      "Сводит свои демо-записи прямо на ноутбуке в салоне автомобиля.",
      "Темп большинства его треков синхронизирован с пульсом ночного хайвея."
    ],
    "mc_oparysh": [
      "Использует сэмплы настоящих индустриальных механизмов и эхо бетонных бункеров.",
      "Принципиально выпускает музыку только в закрытом каталоге без цензуры.",
      "Его саб-частоты опускаются ниже 28 Гц."
    ]
  },

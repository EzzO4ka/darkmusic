{
  "name": "dark-music",
  "version": "4.0.0",
  "private": true,
  "description": "Dark Music - Music App",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "python3 -m http.server 3000 --bind 0.0.0.0",
    "build": "echo Dark Music build ready",
    "lint": "echo Dark Music lint ok",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.lokiq.darkmusic",
    "productName": "Dark Music",
    "protocols": [
      {
        "name": "Dark Music",
        "schemes": [
          "darkmusic"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "catalog.json",
      "logo.png",
      "sw.js",
      "src/**/*",
      "public/**/*",
      "avatars/**/*",
      "banners/**/*",
      "covers/**/*",
      "tracks/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dark Music"
    }
  }
}
